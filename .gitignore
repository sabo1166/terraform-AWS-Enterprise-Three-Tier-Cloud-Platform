# Terraform local data, state and plans (may contain secrets)
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfplan
tfplan

# Variable files with real values (keep *.example)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Backend config with real values (backend.hcl.example is not matched)
*backend*.hcl

# Overrides and local env
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.env
*.pem
