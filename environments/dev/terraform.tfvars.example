# Copy to terraform.tfvars (git-ignored). Non-secret values only.
# The database password is NOT set here: use  $env:TF_VAR_db_password = "..."

region       = "us-east-1"
project_name = "three-tier"
environment  = "dev"

# Cost: one NAT Gateway (AZ-A). Use "per_az" for NAT redundancy (about double NAT cost).
nat_gateway_mode = "single"

# --- No domain: HTTP-only development mode (traffic is NOT encrypted) ---
domain_name     = ""
allow_http_only = true

# --- With a domain (HTTPS). Requires an existing public hosted zone. ---
# domain_name     = "app.example.com"   # replace with a domain you own
# hosted_zone_id  = "Z0000000000000"    # replace with your existing zone ID
# allow_http_only = false

# Application: 2 instances keeps one per AZ.
instance_type        = "t3.micro"
asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4

# Database
db_instance_class = "db.t3.micro"
db_multi_az       = false # true = standby in 2nd AZ, higher cost
